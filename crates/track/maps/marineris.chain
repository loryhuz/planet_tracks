terrain hills 10.0
terrain relief 18.0
# The summit, 80 m: the start and its booster on top, the plunge off its north cliff.
landform mesa 16 -262 62 80
# The butte of the finish, 24 m, the last climb up its flank.
landform butte -400 72 32 24
# The canyon's walls, close along the four sides.
landform mesa -380 390 50 55 760 90
landform mesa -893 -190 55 72 720 0
landform mesa -380 -725 50 52 760 90
landform mesa 150 -40 50 62 260 0
# Inside the loop: a spine of rock between the summit and the finish, a table between the
# finish and the lift hill, a butte south of the last descent.
landform mesa -225 50 42 42 170 0
landform mesa -528 -10 58 46 80 0
landform butte -268 -430 40 46
landform butte -235 -110 18 50
# Hoodoos and boulders: at the foot of the plunge, by the chicane, under the kicker's flight,
# at the foot of the lift hill and by the S at its top, along the south camelbacks, around the
# last turn at height and the finish.
prop spire 70 0 -60 20 8
prop boulder 64 0 30 140 7
